<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- An urgent message shows full screen over the lock screen, as an
         alarm does. Android 14 and later also ask the person to allow it. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Lets the app appear in the list of apps the person may give access
         to Do Not Disturb, which the urgent channel needs to override it. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- The camera only scans the web's QR code, and the server's address
         can be typed instead, so a phone or tablet without one can still
         install the app. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- allowBackup="false" turns off every backup on Android 10 and 11,
         so they need no fullBackupContent; dataExtractionRules turns off
         the device-to-device transfer that Android 12 and later allow
         regardless. -->
    <application
        android:name=".TransomApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Transom">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The server sends the Custom Tab here with the sign-in's
                 one-time code. Android checks transom.sh's assetlinks.json
                 for this app when it is installed, so no other app can
                 claim the link and take the code. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="transom.sh"
                    android:path="/app/callback" />
            </intent-filter>
        </activity>

        <!-- Opens a notification's link. It is not exported, so only
             transom's own notifications start it, and it shows nothing. -->
        <activity
            android:name=".notifications.LinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- An urgent message full screen, which only its notification's
             full-screen intent starts. It shows over the lock screen and turns
             the screen on, as an alarm does, in a task of its own, so it never
             brings the inbox up over the lock screen with it. -->
        <activity
            android:name=".notifications.AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity="sh.transom.alert"
            android:theme="@style/Theme.Transom"
            android:turnScreenOn="true" />

        <!-- The images notifications show, which the system UI reads by the
             URIs Android grants it as each notification is posted. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.images"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/images" />
        </provider>

        <!-- The background connection, which ConnectionService says why
             is a remoteMessaging service. -->
        <service
            android:name=".notifications.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- Replies and swipes from the notifications, which only the
             notifications' own pending intents send. -->
        <receiver
            android:name=".notifications.NotificationReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager's own initializer would make every worker with its
             default factory, which cannot give the outbox's worker the
             account it sends as. TransomApplication gives WorkManager its
             configuration instead, the first time it is asked for. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- FCM's wake-ups and new tokens, which Google Play services hands
             to Firebase's own receiver, and Firebase to this service. -->
        <service
            android:name=".delivery.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- FCM registers the app by its Firebase installation ID, which
             replaces the registration tokens that FCM deprecated, and hands
             the ID to PushService.onRegistered. -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />

        <!-- Firebase's provider would start Firebase from google-services.json
             as the process starts. TransomApplication starts it instead, from
             the values the app was built with, so a build without them never
             starts Firebase at all. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
    </application>

</manifest>
