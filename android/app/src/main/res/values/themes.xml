<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws every screen, so the window needs only a theme that
         follows the system's light or dark setting and draws no action bar. -->
    <style name="Theme.Transom" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
